<Window x:Class="supp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BotSupp Configurator"
        Height="840"
        Width="1280"
        MinHeight="780"
        MinWidth="1180"
        ResizeMode="NoResize"
        Background="#F4F7FC" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#F4F7FC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F7FAFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5D54F0" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#101828" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475467" />
        <SolidColorBrush x:Key="BorderBrushBase" Color="#D9E2F2" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#12B76A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F04438" />

        <Style TargetType="Border" x:Key="PanelCardStyle">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3D35CC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3D35CC" />
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="GhostButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#F2F5FC"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          Margin="0" />
                            </Border>

                            <Border Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource PanelCardStyle}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EAF0FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaqListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrettyToggleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Width="44"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E4E8F2"
                                    BorderBrush="#D0D8E8"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="18"
                                         Height="18"
                                         Fill="White"
                                         Stroke="#CBD5E1"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="3,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowStepsListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C7D7F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlowTableDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FCFDFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6ECF7" />
            <Setter Property="VerticalGridLinesBrush" Value="#E6ECF7" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style x:Key="FlowTableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FC" />
            <Setter Property="BorderBrush" Value="#DCE5F8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="FlowTableCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="FlowTableRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <DataGridCellsPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#C7D7F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#DDE5F8" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Width" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollRoot" Background="Transparent" Margin="0,1,0,1">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true"
                                   Focusable="false">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AccentScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="4" />
                                <Setter TargetName="ScrollRoot" Property="Margin" Value="1,0,1,6" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Background="{StaticResource SurfaceSoftBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                    <Viewbox Margin="8">
                        <Path Fill="{StaticResource AccentBrush}" Data="M12,2A10,10 0 1,1 2,12A10,10 0 0,1 12,2M12,5A7,7 0 1,0 19,12A7,7 0 0,0 12,5M12,8A4,4 0 1,1 8,12A4,4 0 0,1 12,8Z" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="BotSupp Configurator" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Управление Telegram-ботом, FAQ и процессом запуска" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Border x:Name="RuntimeStatusBadge"
                        Grid.Column="2"
                        Background="#FEE4E2"
                        BorderBrush="#FDA29B"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                            <Path x:Name="RuntimeStatusIcon" Fill="#F04438" Data="M10,4A6,6 0 0,0 2,4L3.6,5.6A3.8,3.8 0 0,1 8.4,5.6M6,8A2,2 0 1,0 8,10A2,2 0 0,0 6,8Z"/>
                        </Viewbox>
                        <TextBlock x:Name="RuntimeStatusText" Text="offline" Foreground="#B42318" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="0,14,0,14">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Data="M10.9,6.9L12,6L10.9,5.1L11.1,3.7L9.7,3.9L8.8,2.8L7.9,3.9L6.5,3.7L6.7,5.1L5.6,6L6.7,6.9L6.5,8.3L7.9,8.1L8.8,9.2L9.7,8.1L11.1,8.3L10.9,6.9ZM8.8,7.4A1.4,1.4 0 1,1 10.2,6A1.4,1.4 0 0,1 8.8,7.4Z"/>
                        </Viewbox>
                        <TextBlock Text="Настройки бота"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8,12,8" Style="{StaticResource LabelStyle}" Text="Рабочая папка" />
                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProjectPathTextBox" Grid.Column="0" IsReadOnly="True" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Content="Открыть папку" Style="{StaticResource GhostButtonStyle}" Click="OpenProjectFolderButton_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,12,8" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Токен Telegram-бота" />
                        <Border Width="16"
                                Height="16"
                                Margin="6,0,0,0"
                                CornerRadius="8"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                ToolTip="Токен нужен, чтобы приложение управляло вашим Telegram-ботом. Получить токен можно у @BotFather: /newbot -> создайте бота -> скопируйте API token.">
                            <TextBlock Text="?"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TokenPasswordBox" Grid.Column="0" />
                        <TextBox x:Name="TokenTextBox" Grid.Column="0" Visibility="Collapsed" />
                        <Button x:Name="ToggleTokenVisibilityButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="👁"
                                ToolTip="Показать/скрыть токен"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="ToggleTokenVisibilityButton_Click" />
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,12,8" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="ADMIN_ID (через запятую)" />
                        <Border Width="16"
                                Height="16"
                                Margin="6,0,0,0"
                                CornerRadius="8"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                ToolTip="ADMIN_ID — это Telegram ID оператора(ов), кто получает запросы пользователей. Узнать ID можно у @userinfobot или @getmyid_bot. Можно указать несколько ID через запятую.">
                            <TextBlock Text="?"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBox x:Name="AdminIdsTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,8,0,8"
                             ToolTip="ADMIN_ID — это Telegram ID оператора(ов), кто получает запросы пользователей. Узнать ID можно у @userinfobot или @getmyid_bot." />

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Width="190" Margin="0,0,10,0" Content="Сохранить .env" Style="{StaticResource PrimaryButtonStyle}" Click="SaveEnvButton_Click" />
                        <Button Width="190" Content="Обновить из .env" Style="{StaticResource GhostButtonStyle}" Click="ReloadEnvButton_Click" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Data="M6,1A5,5 0 1,1 1,6A5,5 0 0,1 6,1M5.8,7.8H6.8V8.8H5.8M6.3,3.3A1.7,1.7 0 0,0 4.6,5H5.6A0.7,0.7 0 1,1 7,5C7,5.7 6,5.6 6,7H7C7,6.1 8,5.9 8,5A1.7,1.7 0 0,0 6.3,3.3Z"/>
                        </Viewbox>
                        <TextBlock Text="FAQ-редактор"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Background="#FCFDFF">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Карточки FAQ" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <ListBox x:Name="FaqListBox"
                                         Grid.Row="1"
                                         SelectionChanged="FaqListBox_SelectionChanged"
                                         ItemContainerStyle="{StaticResource FaqListBoxItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,6,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CardBorder"
                                                    Margin="0,0,0,8"
                                                    Padding="11"
                                                    Height="126"
                                                    BorderBrush="#DCE5F8"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Background="#F8FAFF"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="Защищено от удаления" Foreground="#B54708" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                            <Grid Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Редактор записи" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,10,6" Style="{StaticResource LabelStyle}" Text="Ключ" />
                                <TextBox x:Name="FaqKeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,10,6" Style="{StaticResource LabelStyle}" Text="Вопрос" />
                                <TextBox x:Name="FaqQuestionTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,10,6" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Text="Ответ" />
                                <TextBox x:Name="FaqAnswerTextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,6,0,6"
                                         Padding="12,12"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalContentAlignment="Top"
                                         Height="190"
                                         MinHeight="190" />

                                <CheckBox x:Name="FaqProtectedCheckBox"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Margin="0,6,0,0"
                                          Style="{StaticResource PrettyToggleCheckBoxStyle}"
                                          Content="Защита от удаления" />

                                <CheckBox x:Name="FaqEnableFlowCheckBox"
                                          Grid.Row="5"
                                          Grid.Column="1"
                                          Margin="0,8,0,0"
                                          Style="{StaticResource PrettyToggleCheckBoxStyle}"
                                          Content="Включить сценарий"
                                          Checked="FaqEnableFlowCheckBox_Changed"
                                          Unchecked="FaqEnableFlowCheckBox_Changed" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,6,10,6" Style="{StaticResource LabelStyle}" Text="Стартовый шаг" />
                                <ComboBox x:Name="FlowStartStepComboBox"
                                          Grid.Row="6"
                                          Grid.Column="1"
                                          Margin="0,6,0,6"
                                          MinHeight="34"
                                          SelectionChanged="FlowStartStepComboBox_SelectionChanged" />

                                <TextBlock Grid.Row="7"
                                           Grid.ColumnSpan="2"
                                           Text="Конструктор сценария"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,10,0,6" />

                                <Grid Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.95*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="1.95*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" CornerRadius="8" Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Шаги" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ListBox x:Name="FlowStepsListBox"
                                                     Grid.Row="1"
                                                     DisplayMemberPath="Id"
                                                     ItemContainerStyle="{StaticResource FlowStepsListBoxItemStyle}"
                                                     SelectionChanged="FlowStepsListBox_SelectionChanged"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="2"
                                                     MinHeight="130" />
                                            <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                                <Button Width="120" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}" Click="AddFlowStepButton_Click" Content="Добавить шаг" />
                                                <Button Width="120" Style="{StaticResource GhostButtonStyle}" Click="DeleteFlowStepButton_Click" Content="Удалить шаг" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" CornerRadius="8" Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Редактор шага" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="ID шага" />
                                            <TextBox x:Name="FlowStepIdTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" TextChanged="FlowStepEditor_TextChanged" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Текст шага" VerticalAlignment="Top" />
                                            <TextBox x:Name="FlowStepTextTextBox"
                                                     Grid.Row="2"
                                                     Grid.Column="1"
                                                     Margin="0,4,0,4"
                                                     MinHeight="72"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top"
                                                     TextChanged="FlowStepEditor_TextChanged" />

                                            <DataGrid x:Name="FlowTransitionsDataGrid"
                                                      Grid.Row="3"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,6,0,0"
                                                      Style="{StaticResource FlowTableDataGridStyle}"
                                                      RowStyle="{StaticResource FlowTableRowStyle}"
                                                      CellStyle="{StaticResource FlowTableCellStyle}"
                                                      ColumnHeaderStyle="{StaticResource FlowTableHeaderStyle}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      MinHeight="120"
                                                      RowEditEnding="FlowTransitionsDataGrid_RowEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Кнопка" Binding="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                                    <DataGridTextColumn Header="Следующий Шаг" Binding="{Binding TargetStepId, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                                    <DataGridTextColumn Header="Действие" Binding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                <Button Width="150" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}" Click="AddFlowTransitionButton_Click" Content="Добавить переход" />
                                                <Button Width="150" Style="{StaticResource GhostButtonStyle}" Click="DeleteFlowTransitionButton_Click" Content="Удалить переход" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,14,0,8" ItemHeight="42">
                        <Button Width="160" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="AddFaqButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Добавить"/>
                            </StackPanel>
                        </Button>
                        <Button Width="160" Margin="0,0,10,0" Style="{StaticResource GhostButtonStyle}" Click="DeleteFaqButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✕" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Удалить"/>
                            </StackPanel>
                        </Button>
                        <Button Width="160" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Click="SaveFaqButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Fill="White" Data="M2,2H8L10,4V10H2M3,3V9H9V4.5L7.5,3M4,3.5H7V5H4Z"/>
                                </Viewbox>
                                <TextBlock Text="Сохранить FAQ"/>
                            </StackPanel>
                        </Button>
                        <Button Width="160" Style="{StaticResource GhostButtonStyle}" Click="ReloadFaqButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                    <Path Fill="{StaticResource AccentBrush}" Data="M6,2A4,4 0 0,1 9.6,4.3V3H10.6V6H7.6V5H9A3,3 0 1,0 9,7H10A4,4 0 1,1 6,2Z"/>
                                </Viewbox>
                                <TextBlock Text="Загрузить FAQ"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Data="M3,2L10,6L3,10Z"/>
                        </Viewbox>
                        <TextBlock Text="Управление ботом"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Background="{StaticResource SurfaceSoftBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StartBotButton" Width="130" Style="{StaticResource PrimaryButtonStyle}" Click="StartBotButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Path Fill="White" Data="M2,1L10,6L2,11Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Start"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RestartBotButton" Grid.Column="1" Width="130" Margin="10,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="RestartBotButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Path Fill="{StaticResource AccentBrush}" Data="M6,2A4,4 0 0,1 9.6,4.3V3H10.6V6H7.6V5H9A3,3 0 1,0 9,7H10A4,4 0 1,1 6,2Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Restart"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopBotButton" Grid.Column="2" Width="130" Margin="10,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="StopBotButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Viewbox Width="12" Height="12" Margin="0,0,6,0">
                                        <Path Fill="{StaticResource AccentBrush}" Data="M2,2H10V10H2Z"/>
                                    </Viewbox>
                                    <TextBlock Text="Stop"/>
                                </StackPanel>
                            </Button>

                            <Border Grid.Column="3" Margin="16,0,0,0" Background="White" BorderBrush="{StaticResource BorderBrushBase}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <TextBlock x:Name="ProcessStatusTextBlock" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Статус: остановлен" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Логи бота" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <TextBox x:Name="LogTextBox"
                                     Grid.Row="1"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     MinHeight="320"
                                     Background="#0B1220"
                                     Foreground="#D0D9FF"
                                     BorderBrush="#1F2937"
                                     BorderThickness="1"
                                     Padding="10" />
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Style="{StaticResource PanelCardStyle}"
                Background="{StaticResource SurfaceSoftBrush}"
                Padding="10,8">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ℹ" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusTextBlock" Text="Готово к работе." Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
