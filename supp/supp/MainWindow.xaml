<Window x:Class="supp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BotSupp Studio" Height="820" Width="1280" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F7FC">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="BorderBrushBase" Color="#D9E2F2" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushBase}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="#F7FAFF">
            <DockPanel>
                <TextBlock Text="BotSupp Studio" FontSize="22" FontWeight="Bold" Foreground="#101828" />
                <TextBlock x:Name="HeaderStatusText" Text="Готово" HorizontalAlignment="Right" DockPanel.Dock="Right" Foreground="#475467" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Боты" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                    <ListBox x:Name="BotsListBox" Grid.Row="1" SelectionChanged="BotsListBox_SelectionChanged" BorderBrush="#E6ECF7">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock FontWeight="Bold"><Run Text="{Binding StatusIcon}" /><Run Text=" " /><Run Text="{Binding Name}" /></TextBlock><TextBlock Text="{Binding Id}" Foreground="#667085" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="+ Добавить бота" Click="AddBotButton_Click" Background="#4F46E5" Foreground="White" />
                        <Button Content="Удалить выбранного" Click="DeleteBotButton_Click" />
                        <Button Content="Открыть папку" Click="OpenBotFolderButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl>
                    <TabItem Header="Настройки">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Название бота" FontWeight="SemiBold" />
                                <TextBox x:Name="BotNameTextBox" Grid.Row="1" />
                                <TextBlock Grid.Row="2" Text="Токен Telegram-бота" FontWeight="SemiBold" />
                                <PasswordBox x:Name="TokenPasswordBox" Grid.Row="3" />
                                <TextBlock Grid.Row="4" Text="ADMIN_ID через запятую" FontWeight="SemiBold" />
                                <TextBox x:Name="AdminIdsTextBox" Grid.Row="5" />
                                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="UseProxyCheckBox" Content="Использовать общий прокси" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="Сохранить настройки" Click="SaveBotSettingsButton_Click" Background="#4F46E5" Foreground="White" />
                                    <Button Content="Обновить" Click="ReloadBotButton_Click" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Конструктор">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="scenario.json выбранного бота" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBox x:Name="ScenarioTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Сохранить сценарий" Click="SaveScenarioButton_Click" Background="#4F46E5" Foreground="White" />
                                <Button Content="Загрузить сценарий" Click="ReloadScenarioButton_Click" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Запуск и консоль">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="▶ Start" Click="StartBotButton_Click" Background="#12B76A" Foreground="White" />
                                <Button Content="■ Stop" Click="StopBotButton_Click" />
                                <Button Content="↻ Restart" Click="RestartBotButton_Click" />
                                <CheckBox x:Name="ShowAllLogsCheckBox" Content="Показывать все логи" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True" />
                            </StackPanel>
                            <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#0B1220" Foreground="#D0D9FF" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Background="#F7FAFF" Padding="10,8"><TextBlock x:Name="StatusTextBlock" Text="Готово к работе." Foreground="#475467" /></Border>
    </Grid>
</Window>
